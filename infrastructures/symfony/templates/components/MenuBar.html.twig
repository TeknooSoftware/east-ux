{% macro menu_section(section, dropdownId) %}
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="{{ dropdownId }}" role="button" data-bs-toggle="dropdown">
            {% if section.icon %}<span class="menu-icon {{ section.icon }}" aria-hidden="true"></span> {% endif %}{% if section.rawLabel %}{{ section.name }}{% else %}{{ section.name|trans({}, section.translationDomain) }}{% endif %}
        </a>
        <ul class="dropdown-menu">
            {% for item in section.items %}
                {% if item.divider %}
            <li><hr class="dropdown-divider"></li>
                {% else %}
                    {% set item_attributes = item.attributes %}
                    {# An item with a route and a window opens the window in the page (window-dynamic-loader), its link
                       stays the fallback; the props are a JSON object, `{}` when empty (`[]` is refused by Stimulus).
                       The ARIA labels of the props are translation keys, translated as the title of the window #}
                    {% if item.window is not null and item.route is not empty %}
                        {% set window_props = item.window.props %}
                        {% if window_props.closeAriaLabel is defined %}
                            {% set window_props = window_props|merge({'closeAriaLabel': window_props.closeAriaLabel|trans({}, item.translationDomain)}) %}
                        {% endif %}
                        {% if window_props.resizeAriaLabel is defined %}
                            {% set window_props = window_props|merge({'resizeAriaLabel': window_props.resizeAriaLabel|trans({}, item.translationDomain)}) %}
                        {% endif %}
                        {% set window_props_json = '{}' %}
                        {% if window_props is not empty %}{% set window_props_json = window_props|json_encode %}{% endif %}
                        {% set item_attributes = item_attributes|merge({
                            'data-controller': ((item_attributes['data-controller'] ?? '') ~ ' window-dynamic-loader')|trim,
                            'data-action': ((item_attributes['data-action'] ?? '') ~ ' click->window-dynamic-loader#open')|trim,
                            'data-window-dynamic-loader-url-value': path('_teknoo_east_ux_component_render'),
                            'data-window-dynamic-loader-component-value': item.window.component,
                            'data-window-dynamic-loader-title-value': item.window.title|trans({}, item.translationDomain),
                            'data-window-dynamic-loader-props-value': window_props_json
                        }) %}
                    {% endif %}
                    {% set itemAttributes %}{% for name, value in item_attributes %} {{ name|e('html_attr') }}="{{ value }}"{% endfor %}{% endset %}
                    {% set itemLabel %}{% if item.icon %}<span class="menu-icon {{ item.icon }}" aria-hidden="true"></span> {% endif %}{% if item.rawLabel %}{{ item.name }}{% else %}{{ item.name|trans({}, item.translationDomain) }}{% endif %}{% endset %}
                    {% if item.route is empty %}
            <li><button type="button" class="dropdown-item"{{ itemAttributes }}>{{ itemLabel }}</button></li>
                    {% else %}
            <li><a class="dropdown-item" href="{{ path(item.route, item.routeParameters) }}"{{ itemAttributes }}>{{ itemLabel }}</a></li>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </ul>
    </li>
{% endmacro %}
{# The `leave-confirm` controller asks the modal rendered after the menu bar before one of its links leaves a page where
   floating windows are shown; the entries opening a window are left to `window-dynamic-loader` #}
<nav {{ attributes.defaults({
    class: 'navbar navbar-expand-lg fixed-top',
    'data-controller': 'leave-confirm',
    'data-action': 'click->leave-confirm#confirm',
    'data-leave-confirm-modal-id-value': 'leave-confirm-modal'
}) }}>
    <div class="container-fluid">
        <a class="navbar-brand" href="{% if this.getHomeRoute() is not empty %}{{ path(this.getHomeRoute()) }}{% else %}/{% endif %}">
            {% block brand %}
                {{ 'teknoo.east.ux.menu_bar.brand.title'|trans({}, 'east_ux') }}
            {% endblock %}
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            {% block left_sections %}
                <ul class="navbar-nav me-auto">
                    {% for section in this.getLeftItems() %}
                        {{ _self.menu_section(section, 'menuBarLeftDropdown' ~ loop.index) }}
                    {% endfor %}
                </ul>
            {% endblock %}
            {% block right_sections %}
                <ul class="navbar-nav ms-auto">
                    {% for section in this.getRightItems() %}
                        {{ _self.menu_section(section, 'menuBarRightDropdown' ~ loop.index) }}
                    {% endfor %}
                </ul>
            {% endblock %}
        </div>
    </div>
</nav>
{# After the menu bar, not in it: the stacking context of `.fixed-top` would keep the modal under the backdrop #}
<twig:ConfirmModal
        modalId="leave-confirm-modal"
        title="{{ 'teknoo.east.ux.menu_bar.modal.leave_title'|trans({}, 'east_ux') }}"
        message="{{ 'teknoo.east.ux.menu_bar.modal.leave_message'|trans({}, 'east_ux') }}"
        confirmText="{{ 'teknoo.east.ux.menu_bar.action.leave'|trans({}, 'east_ux') }}"
        cancelText="{{ 'teknoo.east.ux.menu_bar.action.cancel'|trans({}, 'east_ux') }}"
        confirmClass="btn-danger"
/>
